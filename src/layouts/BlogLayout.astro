---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  date?: string;
  tags?: string[];
  lang?: "en" | "ar";
}

const { title, description, date, tags, lang = "en" } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString(lang === "ar" ? "ar-SA" : "en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="max-w-3xl mx-auto px-6 py-20">
    <header class="mb-14">
      {
        formattedDate && (
          <time class="font-label text-sm text-on-surface-muted tracking-wider uppercase">
            {formattedDate}
          </time>
        )
      }
      <h1
        class="font-display text-5xl font-semibold tracking-tight text-on-surface mt-4 leading-tight"
        style="letter-spacing: -0.02em;"
      >
        {title}
      </h1>
      {
        description && (
          <p class="font-body text-xl text-on-surface-muted mt-5 leading-relaxed">
            {description}
          </p>
        )
      }
      {
        tags && tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {tags.map((tag) => (
              <a
                href={`${lang === "ar" ? "/ar" : ""}/blog?tag=${encodeURIComponent(tag)}`}
                class="font-label text-xs px-3 py-1 rounded-full transition-colors duration-150"
                style="background-color: rgba(46,196,196,0.08); color: #2EC4C4; border: 1px solid rgba(46,196,196,0.2);"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
