---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagFilter from "../../components/TagFilter.tsx";
import type { PostItem } from "../../components/TagFilter.tsx";

const all = await getCollection("writing");
const posts = all
  .filter((p) => p.id.startsWith("en/") && !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const serialized: PostItem[] = posts.map((p) => ({
  slug: p.id.slice(3),
  title: p.data.title,
  description: p.data.description,
  date: new Date(p.data.date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }),
  tags: p.data.tags,
  type: p.data.type,
  href: `/blog/${p.id.slice(3)}`,
}));

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<BaseLayout title="Writing" description="Essays and notes on engineering, craft, and curiosity.">
  <div class="max-w-3xl mx-auto px-6 py-20">

    <header class="mb-16">
      <p class="font-label text-xs text-primary uppercase tracking-widest mb-3">Writing</p>
      <h1 class="font-display font-semibold text-on-surface" style="font-size: 3rem; letter-spacing: -0.02em;">
        Knowledge Garden
      </h1>
      <p class="font-body text-lg text-on-surface-muted mt-4 leading-relaxed max-w-lg">
        Long-form essays and short evolving notes — ideas at different stages of growth.
      </p>
    </header>

    {serialized.length === 0 ? (
      <p class="font-label text-sm text-on-surface-muted text-center py-12">
        Nothing here yet — check back soon.
      </p>
    ) : (
      <TagFilter client:load posts={serialized} allTags={allTags} />
    )}

  </div>
</BaseLayout>
